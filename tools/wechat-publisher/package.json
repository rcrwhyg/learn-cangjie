{
  "name": "@learn-cangjie/wechat-publisher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "wechat-publisher": "dist/cli/index.js",
    "wechat-publisher-mcp": "dist/mcp/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli/index.ts",
    "mcp": "tsx src/mcp/index.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
